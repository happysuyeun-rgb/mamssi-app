# Supabase
VITE_SUPABASE_URL=...
VITE_SUPABASE_ANON_KEY=...

# Mixpanel (선택) - 미설정 시 이벤트 미전송
VITE_MIXPANEL_TOKEN=

# 고객문의 API (선택) - 로컬에서 API 다른 주소 쓸 때만. 배포 시 같은 도메인이면 비워두면 됨
# VITE_API_URL=https://your-app.vercel.app

# --- Vercel 서버(API) 전용 (프로젝트 루트 .env에 넣지 말고 Vercel 대시보드 환경변수에 설정) ---
# SUPABASE_URL=...          (VITE_SUPABASE_URL과 동일 값)
# SUPABASE_ANON_KEY=...     (VITE_SUPABASE_ANON_KEY와 동일 값)
# GMAIL_USER=mamssi.official@gmail.com
# GMAIL_PASS=...            (Gmail 앱 비밀번호)
